# Copy to .env and adjust as needed. scripts/bootstrap.sh writes the two secrets itself.

# Minted by scripts/bootstrap.sh — one per integration, because a secret binds to the first
# project/component that presents it.
# ICP_EXPENSE_SECRET=
# ICP_ORDERS_SECRET=

# Where the integrations register themselves.
ICP_PROJECT=workflow_icp_test
ICP_ENVIRONMENT=dev

# Host ports.
CONSOLE_PORT=9664
# What the BROWSER is told to call, which behind the edge proxy is not a node's own address.
# The frontend's config.json and the CORS allowlist are derived from it, so if this does not
# match CONSOLE_PORT the console loads and every request from it fails.
ICP_PUBLIC_BASE_URL=https://localhost:9664
RUNTIME_PORT=9445
TEMPORAL_UI_PORT=8233
POSTGRES_PORT=55432

# nginx.pinned.conf keeps the tunnel working while ICP is clustered;
# nginx.roundrobin.conf reproduces the single-instance limitation instead.
EDGE_CONF=nginx.roundrobin.conf

# 2 with --cluster, 1 otherwise.
INTEGRATION_REPLICAS=1

# Memory. Lower these before raising replicas on a small Docker VM. Temporal and its
# database add roughly 400 MB over a dev server.
ICP_HEAP=512m
INTEGRATION_HEAP=384m

# Heartbeat cadence. The tunnel's first command after an idle period waits up to one full
# interval, so keep this well below the ICP's 25s waiter.
HEARTBEAT_INTERVAL=10

# Database. The superuser runs the init scripts; the server connects as icp_user.
ICP_DB_NAME=icp_db
ICP_DB_USER=icp_user
ICP_DB_PASSWORD=icp_password
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERPASSWORD=postgres

# The open-source Temporal server (auto-setup) and its own Postgres, on integration-net.
TEMPORAL_TAG=1.29.7
TEMPORAL_UI_TAG=2.53.3
TEMPORAL_DB_USER=temporal
TEMPORAL_DB_PASSWORD=temporal
